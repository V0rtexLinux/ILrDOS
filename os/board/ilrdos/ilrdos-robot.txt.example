# ILrDOS - configuração do robô (edite no PC, partição BOOT do cartão SD). Linhas com # são comentários.
# Tudo é opcional: o que ficar vazio usa o padrão ou desliga o recurso.

# ---- Conversa (PC da rede local com Ollama; o robô só conversa por regras se ficar vazio)
PC_IP=
OLLAMA_MODEL=qwen2.5:7b-instruct
# TTS_VOICE=glados            # servidor de voz do PC na porta 5050 (sem ele, usa espeak)
# WAKE_WORDS=ilrdos,ilr dos,ele erre dos,robo
SEND_NAMES_TO_LLM=1           # 0 = o PC nunca recebe os nomes das pessoas reconhecidas

# ---- Locomoção (pinos BCM). Ponte H tipo L298N/DRV8833. Deixe vazio se não tiver rodas.
MOTOR_LEFT_FWD=
MOTOR_LEFT_REV=
MOTOR_RIGHT_FWD=
MOTOR_RIGHT_REV=
# MOTOR_ENABLE_PINS=12,13     # ENA/ENB mantidos em nível alto
MOTOR_MAX_SPEED=60            # % máximo de velocidade
TURN_MS_PER_90=700            # calibre: milissegundos para girar 90 graus
# ---- Movimento conforme a estrutura do desenho (cabos de energia -/+ e de dados do visor até o cérebro)
MAX_TWIST_DEG=270             # giro acumulado máximo para cada lado antes de esticar os cabos (use `untwist`)
# MOTOR_RAMP_MS=300           # partida/parada suaves (0 = sem rampa)
# REVERSE_SETTLE_MS=250       # pausa com rodas paradas ao inverter o sentido
# IMPACT_LOCKOUT_MS=4000      # sem mover por alguns segundos depois de queda/batida no casco
# TWIST_FILE=/var/lib/ilrdos/twist.txt   # guarda a torção dos cabos entre reinícios
# ---- Sonar HC-SR04 (ECHO precisa de divisor de tensão 5V->3,3V!)
SONAR_TRIG=
SONAR_ECHO=
SONAR_STOP_CM=20
# off | track (encara quem está na frente) | roam (também se aproxima e passeia) | auto
MOTION_AUTONOMY=auto
# TRACK_INVERT=1              # inverta se o robô girar para o lado errado ao seguir um rosto

# ---- Estrutura (comando "structure": energia, cérebro, cabos de dados, casco, visor)
# THROTTLED_FILE=/sys/devices/platform/soc/soc:firmware/get_throttled   # sensor de tensão dos cabos -/+ (opcional)

# ---- Sensor de impacto do casco protetor (queda/batida → para motores + bip suave 3×)
# Sensor: SW-420, KY-002 ou qualquer chave de vibração digital (pino BCM, nível alto = impacto).
# Buzzer: buzzer passivo (NÃO use ativo; precisa de PWM). ~900 Hz = audível sem irritar.
# IMPACT_SENSOR_PIN=20
# IMPACT_BUZZER_PIN=21
# IMPACT_BUZZER_FREQ_HZ=900   # 600–1200 Hz recomendado; padrão 900 Hz

# ---- Rostos
# FACE_THRESHOLD=0.40         # sobe = mais rígido (menos confusões), desce = reconhece mais fácil

# ---- Áudio ("auto" escolhe a placa USB)
# AUDIO_IN=auto
# AUDIO_OUT=auto

# ---- Reconhecimento de fala (Pi OS: baixe o modelo Vosk e aponte aqui)
# VOSK_MODEL=/usr/share/ilrdos/models/vosk-pt
