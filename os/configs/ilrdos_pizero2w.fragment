# ILrDOS — fragmento aplicado sobre raspberrypizero2w_64_defconfig do Buildroot.
# @BASE_...@ é substituído pelo valor que o defconfig base já usa.

# Identidade e segurança
BR2_TARGET_GENERIC_HOSTNAME="ilrdos"
BR2_TARGET_GENERIC_ISSUE="ILrDOS"
# BR2_TARGET_ENABLE_ROOT_LOGIN is not set
BR2_SYSTEM_DHCP=""

# Raiz somente leitura (o cartão SD sobrevive a quedas de energia)
# BR2_TARGET_GENERIC_REMOUNT_ROOTFS_RW is not set
BR2_TARGET_ROOTFS_EXT2_SIZE="256M"

# Toolchain e overlay
BR2_TOOLCHAIN_BUILDROOT_CXX=y
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_ILRDOS_PATH)/board/ilrdos/overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="@BASE_POST_BUILD@ $(BR2_EXTERNAL_ILRDOS_PATH)/board/ilrdos/post-build.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_ILRDOS_PATH)/board/ilrdos/pre-image.sh @BASE_POST_IMAGE@"

# Wi-Fi (BCM43436 do Zero 2 W)
BR2_PACKAGE_BRCMFMAC_SDIO_FIRMWARE_RPI=y
BR2_PACKAGE_BRCMFMAC_SDIO_FIRMWARE_RPI_WIFI=y
BR2_PACKAGE_WPA_SUPPLICANT=y
BR2_PACKAGE_WPA_SUPPLICANT_PASSPHRASE=y

# Visão: OpenCV com DNN (YuNet) e câmera USB V4L2
BR2_PACKAGE_OPENSSL=y
BR2_PACKAGE_OPENCV4=y
BR2_PACKAGE_OPENCV4_LIB_DNN=y
BR2_PACKAGE_OPENCV4_LIB_IMGPROC=y
BR2_PACKAGE_OPENCV4_LIB_IMGCODECS=y
BR2_PACKAGE_OPENCV4_LIB_OBJDETECT=y
BR2_PACKAGE_OPENCV4_LIB_VIDEOIO=y
BR2_PACKAGE_OPENCV4_WITH_JPEG=y
BR2_PACKAGE_OPENCV4_WITH_V4L=y

# Voz: ALSA (áudio), espeak (voz de reserva) e libvosk (reconhecimento, pacote ilrdos-vosk)
BR2_PACKAGE_ALSA_LIB=y
BR2_PACKAGE_ALSA_UTILS=y
BR2_PACKAGE_ESPEAK=y
BR2_PACKAGE_ILRDOS_VOSK=y

# O runtime do robô
BR2_PACKAGE_ILRDOS=y
