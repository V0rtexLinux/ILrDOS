config BR2_PACKAGE_ILRDOS
	bool "ilrdos"
	depends on BR2_INSTALL_LIBSTDCPP
	depends on BR2_TOOLCHAIN_HAS_THREADS
	select BR2_PACKAGE_ALSA_LIB
	help
	  Runtime do robô ILrDOS: daemon de controle (GPIO, visão e
	  reconhecimento de rostos, voz, locomoção, IoT, autonomia e
	  console Wi-Fi autenticado por HMAC-SHA256).

comment "ilrdos needs a toolchain w/ C++, threads"
	depends on !BR2_INSTALL_LIBSTDCPP || !BR2_TOOLCHAIN_HAS_THREADS
