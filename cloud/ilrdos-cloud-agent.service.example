[Unit]
Description=ILrDOS Robot Cloud Sync Agent
After=network-online.target ilrdos.service
Wants=network-online.target

[Service]
Type=simple
User=ilrdos
Group=ilrdos
EnvironmentFile=/etc/ilrdos-cloud/agent.env
ExecStart=/usr/bin/python3 /opt/ilrdos/cloud/agent.py run --url ${ILRDOS_CLOUD_URL} --state-dir /var/lib/ilrdos-cloud --local-token-file /etc/ilrdos/token
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/ilrdos-cloud
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
