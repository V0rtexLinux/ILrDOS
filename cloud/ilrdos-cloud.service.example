[Unit]
Description=ILrDOS Cloud Sync API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ilrdos-cloud
Group=ilrdos-cloud
WorkingDirectory=/opt/ilrdos/cloud
EnvironmentFile=/etc/ilrdos-cloud/server.env
ExecStart=/usr/bin/python3 /opt/ilrdos/cloud/server.py
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/ilrdos-cloud
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
